/* 页面基础 */
.page {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.page.show {
  opacity: 1;
}

/* 顶部标题 */
.header {
  display: flex;
  flex-direction: column;
  padding: 80rpx 0 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: rgba(108, 92, 231, 0.3);
  box-shadow: 0 0 20rpx rgba(108, 92, 231, 0.2);
}

.tab-icon {
  font-size: 28rpx;
}

.tab-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 600;
}

/* 我的排名 */
.my-rank {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(108, 92, 231, 0.2) 0%, rgba(0, 210, 255, 0.1) 100%);
  border: 1rpx solid rgba(108, 92, 231, 0.3);
}

.my-rank-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-position {
  font-size: 32rpx;
  font-weight: 800;
  color: #C07A45;
  min-width: 60rpx;
}

.my-avatar {
  font-size: 40rpx;
}

.my-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.my-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.my-rank-badge {
  font-size: 22rpx;
}

.my-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD700;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 排行榜列表 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s ease;
  opacity: 0;
  transform: translateY(10rpx);
  animation: fadeInUp 0.3s ease forwards;
  animation-delay: var(--delay);
}

.rank-item.top-3 {
  background: rgba(255, 215, 0, 0.05);
  border-color: rgba(255, 215, 0, 0.1);
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 排名 */
.rank-position {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.position-number {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}

.position-number.top {
  opacity: 0;
}

.position-icon {
  font-size: 32rpx;
  position: absolute;
}

/* 用户信息 */
.rank-user {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 12rpx;
}

.user-avatar {
  font-size: 36rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-rank {
  font-size: 22rpx;
}

/* 分数 */
.rank-score {
  display: flex;
  align-items: center;
}

.score-number {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFD700;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 登录区域 */
.login-section {
  padding: 40rpx 0;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 16rpx;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
}

.login-form {
  width: 100%;
  margin-bottom: 24rpx;
}

.login-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100% !important;
  border-radius: 16rpx !important;
}

/* 加载中 */
.loading-section {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 头像图片 */
.my-avatar-img,
.user-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 当前用户高亮 */
.rank-item.is-me {
  background: rgba(108, 92, 231, 0.15);
  border-color: rgba(108, 92, 231, 0.3);
}
