<view class="page {{show ? 'show' : ''}}">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">排行榜</text>
    <text class="subtitle">挑战全网玩家</text>
  </view>

  <!-- 未登录状态 -->
  <view class="login-section" wx:if="{{!isLoggedIn && !loading}}">
    <view class="login-card card">
      <text class="login-icon">🏆</text>
      <text class="login-title">登录后查看排行榜</text>
      <text class="login-desc">输入昵称即可参与排行</text>

      <view class="login-form">
        <input class="login-input" placeholder="输入你的昵称" maxlength="12"
          bindinput="onInputNickname" value="{{userInfo.nickName}}" />
      </view>

      <button class="btn-primary login-btn" bindtap="onConfirmLogin"
        style="background: linear-gradient(135deg, #6C5CE7 0%, #00D2FF 100%)">
        登录并参与排行
      </button>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-section" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 已登录状态 -->
  <block wx:if="{{isLoggedIn && !loading}}">
    <!-- 我的排名 -->
    <view class="my-rank card" wx:if="{{myRank}}">
      <view class="my-rank-left">
        <text class="my-position">#{{myRank.position}}</text>
        <image class="my-avatar-img" wx:if="{{myRank.avatarUrl}}" src="{{myRank.avatarUrl}}" mode="aspectFill" />
        <text class="my-avatar" wx:else>😊</text>
        <view class="my-info">
          <text class="my-name">{{myRank.name}}</text>
          <text class="my-rank-badge" style="color: {{myRank.rankInfo.color}}">{{myRank.rankInfo.icon}} {{myRank.rankInfo.name}}</text>
        </view>
      </view>
      <view class="my-score">
        <text class="score-value">{{myRank.score}}</text>
        <text class="score-label">积分</text>
      </view>
    </view>

    <!-- 排行榜列表 -->
    <view class="rank-list">
      <view
        class="rank-item {{item.isMe ? 'is-me' : ''}} {{index < 3 ? 'top-3' : ''}}"
        wx:for="{{rankList}}"
        wx:key="id"
        style="--delay: {{index * 0.05}}s"
      >
        <!-- 排名 -->
        <view class="rank-position">
          <text class="position-number {{item.position <= 3 ? 'top' : ''}}">{{item.position}}</text>
          <text class="position-icon" wx:if="{{item.position === 1}}">🥇</text>
          <text class="position-icon" wx:elif="{{item.position === 2}}">🥈</text>
          <text class="position-icon" wx:elif="{{item.position === 3}}">🥉</text>
        </view>

        <!-- 用户信息 -->
        <view class="rank-user">
          <image class="user-avatar-img" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text class="user-avatar" wx:else>{{item.avatar}}</text>
          <view class="user-info">
            <text class="user-name">{{item.name}}</text>
            <text class="user-rank" style="color: {{item.rankInfo.color}}">{{item.rankInfo.icon}} {{item.rankInfo.name}}</text>
          </view>
        </view>

        <!-- 分数 -->
        <view class="rank-score">
          <text class="score-number">{{item.score}}</text>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{rankList.length > 0}}">
      <text class="load-text">— 共 {{rankList.length}} 名玩家 —</text>
    </view>
    <view class="load-more" wx:if="{{rankList.length === 0}}">
      <text class="load-text">暂无数据，快来成为第一名！</text>
    </view>
  </block>
</view>
