/* 页面基础 */
.page {
  min-height: 100vh;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.page.show {
  opacity: 1;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: 80rpx;
}

.nav-back,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.nav-back:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.nav-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 准备屏幕 */
.ready-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 32rpx;
}

.ready-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.animate-scale-in {
  animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

.ready-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.ready-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.ready-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.ready-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 48rpx;
}

/* 难度选择 */
.level-selector {
  display: flex;
  gap: 12rpx;
  margin-bottom: 48rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.level-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.level-btn:active {
  transform: scale(0.92);
}

.level-btn.active {
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.3);
}

.start-btn {
  width: 100%;
  max-width: 400rpx;
  border-radius: 24rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.3);
  transition: transform 0.2s ease;
}

.start-btn:active {
  transform: scale(0.96);
}

/* 展示屏幕 */
.show-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 32rpx;
}

.show-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.show-hint {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 48rpx;
}

.sequence-display {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.seq-num {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx solid;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.seq-num.visible {
  animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.seq-num.hidden {
  opacity: 0.3;
}

@keyframes popIn {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.num-text {
  font-size: 36rpx;
  font-weight: 700;
}

.show-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 80%;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 输入屏幕 */
.input-screen {
  padding: 0 32rpx;
}

.input-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input-timer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.timer-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.timer-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #00D2FF;
  font-family: 'Courier New', monospace;
}

/* 输入序列 */
.input-sequence {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.input-slot {
  display: flex;
  gap: 4rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.input-slot.current {
  border-color: rgba(108, 92, 231, 0.4);
  animation: currentPulse 1.5s ease-in-out infinite;
}

.input-slot.correct {
  border-color: #00B894;
  animation: slotDone 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.input-slot.wrong {
  border-color: #FF6B6B;
  animation: slotShake 0.3s ease;
}

@keyframes slotDone {
  from { transform: scale(0.9); }
  to { transform: scale(1); }
}

@keyframes slotShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

@keyframes currentPulse {
  0%, 100% { box-shadow: 0 0 12rpx rgba(108, 92, 231, 0.15); }
  50% { box-shadow: 0 0 24rpx rgba(108, 92, 231, 0.35); }
}

.digit-box {
  width: 36rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  border: 2rpx solid;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.digit-box.active {
  animation: digitPulse 1s ease-in-out infinite;
}

@keyframes digitPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.digit-box.filled {
  animation: digitFill 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes digitFill {
  from { transform: scale(0.7); }
  to { transform: scale(1); }
}

.digit-text {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.target-hint {
  margin-bottom: 32rpx;
}

.hint-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 数字键盘 */
.number-pad {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  max-width: 400rpx;
}

.pad-row {
  display: flex;
  gap: 16rpx;
}

.pad-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  border: 2rpx solid;
  transition: transform 0.12s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* 按压效果 - 模拟键盘手感 */
.pad-btn.tapping {
  transform: scale(0.92);
  transition: transform 0.08s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.pad-btn.tapping.success {
  box-shadow: 0 0 0 4rpx rgba(0, 184, 148, 0.3);
}

.pad-btn.tapping.error {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 107, 0.3);
  animation: keyErrorShake 0.2s ease;
}

@keyframes keyErrorShake {
  0%, 100% { transform: scale(0.92) translateX(0); }
  25% { transform: scale(0.92) translateX(-4rpx); }
  75% { transform: scale(0.92) translateX(4rpx); }
}

.pad-btn.empty {
  background: transparent !important;
  border-color: transparent !important;
}

.pad-btn.delete {
  background: rgba(255, 107, 107, 0.15) !important;
  border-color: rgba(255, 107, 107, 0.3) !important;
  color: #FF6B6B;
}

/* 完成屏幕 */
.finish-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 32rpx;
}

.finish-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 500rpx;
}

.result-icon-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  animation: resultBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes resultBounce {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 成绩卡片 */
.result-card {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.result-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.result-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.result-value.score {
  font-size: 40rpx;
  color: #FFD700;
}

.result-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 序列对比 */
.sequence-compare {
  width: 100%;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.compare-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
  display: block;
}

.compare-nums {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.compare-num {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.compare-num.correct {
  animation: correctPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes correctPop {
  from { transform: scale(0.8); }
  to { transform: scale(1); }
}

/* 新纪录 */
.new-record {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 165, 0, 0.2) 100%);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  animation: newRecordPulse 1.5s ease-in-out infinite;
}

@keyframes newRecordPulse {
  0%, 100% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.2); }
  50% { box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.4); }
}

.record-icon {
  font-size: 32rpx;
}

.record-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFD700;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  width: 100%;
  border-radius: 20rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.action-buttons .btn-primary:active,
.action-buttons .btn-secondary:active {
  transform: scale(0.96);
}

/* 双倍积分按钮 */
.btn-double {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #1a1a2e;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-double.claimed {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 20rpx;
  transition: opacity 0.2s ease;
}

.share-btn:active {
  opacity: 0.7;
}

.share-icon {
  font-size: 28rpx;
}

.share-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}
