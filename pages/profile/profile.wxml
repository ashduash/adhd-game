<view class="page {{show ? 'show' : ''}}">
  <!-- 固定顶部区域 -->
  <view class="fixed-top">
    <view class="header">
      <text class="title">个人中心</text>
    </view>

    <!-- 个人信息卡片 -->
    <view class="user-card card">
      <view class="user-avatar-area" bindtap="chooseAvatar">
        <image class="user-avatar" wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view class="user-avatar-default" wx:else>
          <text class="avatar-emoji">👤</text>
        </view>
        <view class="user-detail">
          <text class="user-name">{{userInfo.nickName || '点击设置昵称'}}</text>
          <text class="user-id">ID: {{userId}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>

    <!-- 菜单区域 -->
    <view class="menu-section">
      <view class="menu-item" bindtap="showRenameDialog">
        <view class="menu-left">
          <text class="menu-icon">✏️</text>
          <text class="menu-text">修改昵称</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-text">关于</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 可滚动内容区域 -->
  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 段位卡片 -->
    <view class="rank-card card" wx:if="{{rankInfo}}">
      <view class="rank-header">
        <view class="rank-icon-wrapper" style="background: {{rankInfo.color}}20; border-color: {{rankInfo.color}}40;">
          <text class="rank-icon">{{rankInfo.icon}}</text>
        </view>
        <view class="rank-info">
          <text class="rank-name" style="color: {{rankInfo.color}}">{{rankInfo.name}}</text>
          <text class="rank-points">{{userData.rankPoints}} 积分</text>
        </view>
      </view>

      <view class="rank-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{rankProgress * 100}}%; background: {{rankInfo.color}}"></view>
        </view>
        <view class="progress-info" wx:if="{{nextRank}}">
          <text class="progress-text">距离{{nextRank.name}}</text>
          <text class="progress-points">还需{{pointsNeeded}}分</text>
        </view>
        <view class="progress-info" wx:else>
          <text class="progress-text">已达最高段位！</text>
        </view>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="stats-section">
      <view class="stat-card card-glass" wx:for="{{stats}}" wx:key="label">
        <text class="stat-icon">{{item.icon}}</text>
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 最佳成绩 -->
    <view class="section">
      <text class="section-title">最佳成绩</text>
      <view class="best-scores">
        <view class="score-card card" wx:for="{{bestScores}}" wx:key="mode">
          <view class="score-header">
            <text class="score-icon">{{item.icon}}</text>
            <text class="score-name">{{item.name}}</text>
          </view>
          <view class="score-list">
            <view class="score-item" wx:for="{{item.scores}}" wx:for-item="score" wx:key="level">
              <text class="score-level">{{score.level}}</text>
              <text class="score-time">{{score.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 成就 -->
    <view class="section" wx:for="{{achievementCategories}}" wx:key="name" wx:for-item="cat">
      <text class="section-title">{{cat.name}}</text>
      <view class="achievements-grid">
        <block wx:for="{{cat.items}}" wx:key="id">
          <view class="achievement-item unlocked" wx:if="{{item.unlocked}}">
            <text class="achievement-icon">{{item.icon}}</text>
            <text class="achievement-name">{{item.name}}</text>
            <text class="achievement-desc">{{item.desc}}</text>
          </view>
          <view class="achievement-item locked" wx:else>
            <text class="achievement-icon">🔒</text>
            <text class="achievement-name">{{item.name}}</text>
            <text class="achievement-desc">{{item.desc}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="actions">
      <button class="btn-secondary" bindtap="clearData">清除数据</button>
    </view>

    <!-- Banner 广告 -->
    <view class="ad-container">
      <ad unit-id="{{bannerAdId}}" ad-type="banner" ad-theme="white" binderror="onAdError"></ad>
    </view>

    <!-- 版本信息 -->
    <view class="version">
      <text class="version-text">专注风暴 v1.0.0</text>
    </view>
  </scroll-view>

  <!-- 改名弹窗 -->
  <view class="modal-mask" wx:if="{{showRename}}" bindtap="hideRenameDialog">
    <view class="modal-content" catchtap="">
      <text class="modal-title">修改昵称</text>
      <input class="modal-input" value="{{newNickName}}" bindinput="onNickNameInput" placeholder="请输入新昵称" maxlength="12" />
      <view class="modal-btns">
        <button class="modal-btn cancel" bindtap="hideRenameDialog">取消</button>
        <button class="modal-btn confirm" bindtap="confirmRename">确定</button>
      </view>
    </view>
  </view>
</view>
