/* 页面基础 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.3s ease;
  background: #0F0F1A;
}

.page.show {
  opacity: 1;
}

/* 固定顶部区域 */
.fixed-top {
  flex-shrink: 0;
  padding: 0 32rpx;
}

/* 顶部标题 */
.header {
  padding: 80rpx 0 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 个人信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.user-avatar-area {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(108, 92, 231, 0.4);
}

.user-avatar-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(108, 92, 231, 0.2);
  border: 2rpx solid rgba(108, 92, 231, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 44rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 菜单区域 */
.menu-section {
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 可滚动内容区域 */
.scroll-content {
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 段位卡片 */
.rank-card {
  margin-bottom: 24rpx;
  margin-top: 8rpx;
}

.rank-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.rank-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid;
}

.rank-icon {
  font-size: 40rpx;
}

.rank-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rank-name {
  font-size: 36rpx;
  font-weight: 700;
}

.rank-points {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 进度条 */
.rank-progress {
  margin-top: 8rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.progress-text,
.progress-points {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 统计数据 */
.stats-section {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 区域标题 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
}

/* 最佳成绩 */
.best-scores {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-card {
  padding: 20rpx 24rpx;
}

.score-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.score-icon {
  font-size: 28rpx;
}

.score-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.score-list {
  display: flex;
  gap: 24rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.score-level {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.score-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  font-family: 'Courier New', monospace;
}

/* 成就 */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.achievement-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s ease;
}

.achievement-item.unlocked {
  background: rgba(255, 215, 0, 0.05);
  border-color: rgba(255, 215, 0, 0.15);
}

.achievement-item.locked {
  opacity: 0.5;
}

.achievement-icon {
  font-size: 36rpx;
}

.achievement-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.achievement-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

/* 操作区 */
.actions {
  margin-top: 32rpx;
  margin-bottom: 24rpx;
}

.actions .btn-secondary {
  width: 100%;
  color: #FF6B6B;
  border-color: rgba(255, 107, 107, 0.3);
}

/* Banner 广告 */
.ad-container {
  margin: 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 版本信息 */
.version {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.version-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 改名弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 600rpx;
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  border: none;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  color: #ffffff;
  border: none;
}
