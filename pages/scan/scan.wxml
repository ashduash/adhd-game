<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-title">
      <text class="title-text">闪电扫视</text>
      <text class="title-sub">{{level}}个数字 · {{timeLimit}}秒</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 准备状态 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-content animate-scale-in">
      <view class="ready-icon">👁️</view>
      <text class="ready-title">闪电扫视</text>
      <text class="ready-desc">在{{timeLimit}}秒内随机找到所有数字</text>
      <text class="ready-tip">数字顺序随机，考验你的视觉搜索速度！</text>

      <!-- 难度选择 -->
      <view class="level-selector">
        <view
          class="level-btn {{level === 15 && timeLimit === 12 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="15"
          data-time="12"
          style="{{level === 15 && timeLimit === 12 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >15个/12秒</view>
        <view
          class="level-btn {{level === 20 && timeLimit === 12 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="20"
          data-time="12"
          style="{{level === 20 && timeLimit === 12 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >20个/12秒</view>
        <view
          class="level-btn {{level === 25 && timeLimit === 15 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="25"
          data-time="15"
          style="{{level === 25 && timeLimit === 15 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >25个/15秒</view>
        <view
          class="level-btn {{level === 30 && timeLimit === 18 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="30"
          data-time="18"
          style="{{level === 30 && timeLimit === 18 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >30个/18秒</view>
      </view>

      <button class="btn-primary start-btn" bindtap="startGame" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">
        开始挑战
      </button>
      <view class="rules-link" bindtap="openRules">📖 玩法说明</view>
    </view>
  </view>

  <!-- 游戏状态 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <!-- 信息栏 -->
    <view class="info-bar">
      <view class="info-item">
        <text class="info-label">剩余</text>
        <text class="info-value timer {{timeLeft <= 5 ? 'warning' : ''}}">{{timerDisplay}}s</text>
      </view>
      <view class="info-item target-hint">
        <text class="info-label">找</text>
        <text class="next-num" style="color: {{currentSkin.accent}}">{{nextNumber}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">进度</text>
        <text class="info-value">{{foundCount}}/{{level}}</text>
      </view>
    </view>

    <!-- 数字网格 -->
    <view class="grid-container">
      <view class="grid" style="grid-template-columns: repeat({{level <= 20 ? 5 : 6}}, 1fr);">
        <view
          class="grid-cell {{item.found ? 'found' : ''}} {{tappedIndex === item.index ? 'tapping ' + tappedType : ''}}"
          wx:for="{{numbers}}"
          wx:key="index"
          bindtap="tapNumber"
          data-index="{{item.index}}"
          style="
            background: {{item.found ? currentSkin.cell.successBg : (tappedIndex === item.index ? (tappedType === 'success' ? currentSkin.cell.successBg : 'rgba(255,107,107,0.2)') : currentSkin.cell.bg)}};
            border-color: {{item.found ? currentSkin.cell.successBorder : (tappedIndex === item.index ? (tappedType === 'success' ? currentSkin.cell.successBorder : 'rgba(255,107,107,0.4)') : currentSkin.cell.border)}};
            opacity: {{item.found ? 0.5 : 1}};
          "
        >
          <text class="cell-number" style="
            color: {{item.found ? currentSkin.cell.successText : currentSkin.cell.text}};
            text-decoration: {{item.found ? 'line-through' : 'none'}};
          ">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成状态 -->
  <view class="finish-screen" wx:if="{{gameState === 'finished'}}">
    <view class="finish-content animate-scale-in">
      <!-- 评级 -->
      <view class="rating-container">
        <view class="rating-circle" style="border-color: {{ratingColor}}; box-shadow: 0 0 40rpx {{ratingColor}}40;">
          <text class="rating-text" style="color: {{ratingColor}}">{{rating}}</text>
        </view>
        <text class="rating-label" wx:if="{{foundCount >= level}}">全部找到！</text>
        <text class="rating-label" wx:else="">{{foundCount}}/{{level}} 个</text>
      </view>

      <!-- 成绩 -->
      <view class="result-card card">
        <view class="result-item">
          <text class="result-label">找到</text>
          <text class="result-value">{{foundCount}}/{{level}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">正确率</text>
          <text class="result-value">{{accuracy}}%</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">用时</text>
          <text class="result-value">{{timeLimit - timeLeft}}s</text>
        </view>
      </view>

      <!-- 新纪录 -->
      <view class="new-record" wx:if="{{isNewRecord}}">
        <text class="record-icon">🏆</text>
        <text class="record-text">新纪录！</text>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button class="btn-double" wx:if="{{!doubleClaimed}}" bindtap="watchAdDoublePoints">📺 看视频双倍积分 (+{{earnedPoints}})</button>
        <button class="btn-double claimed" wx:else disabled>✅ 双倍积分已领取</button>
        <button class="btn-primary" bindtap="restart" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">再来一次</button>
        <button class="btn-secondary" bindtap="nextLevel" wx:if="{{level < 30}}">下一难度</button>
        <button class="btn-secondary" bindtap="goHome">返回首页</button>
      </view>

      <!-- 分享按钮 -->
      <button class="share-btn" open-type="share">
        <text class="share-icon">📤</text>
        <text class="share-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-overlay {{showGuide ? 'show' : ''}}" catchtap="closeGuide">
    <view class="guide-card" catchtap="">
      <view class="guide-icon">{{guideSteps[guideStep].icon}}</view>
      <text class="guide-title">{{guideSteps[guideStep].title}}</text>
      <text class="guide-desc">{{guideSteps[guideStep].desc}}</text>
      <view class="guide-dots">
        <view class="guide-dot {{index === guideStep ? 'active' : ''}}" wx:for="{{guideSteps}}" wx:key="index"></view>
      </view>
      <view class="guide-btns">
        <view class="guide-btn guide-skip" bindtap="closeGuide">跳过</view>
        <view class="guide-btn guide-next" bindtap="nextGuide">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始游戏'}}</view>
      </view>
    </view>
  </view>

  <!-- 玩法说明 -->
  <view class="rules-overlay {{showRules ? 'show' : ''}}" catchtap="closeRules">
    <view class="rules-card" catchtap="">
      <text class="rules-title">📖 玩法说明</text>
      <scroll-view class="rules-body" scroll-y>
        <view wx:for="{{rulesSections}}" wx:key="title">
          <text class="rules-section-title">{{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="guide-btn guide-next" bindtap="closeRules">知道了</view>
    </view>
  </view>
</view>
