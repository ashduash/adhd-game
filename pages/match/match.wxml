<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome"><text class="back-icon">←</text></view>
    <view class="nav-title">
      <text class="title-text">色彩消除</text>
      <text class="title-sub">{{gridSize}}×{{gridSize}} · 消除配对</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 准备屏幕 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-content animate-scale-in">
      <view class="ready-icon">🌈</view>
      <text class="ready-title">色彩消除</text>
      <text class="ready-desc">点击相邻的同色方块进行消除</text>
      <text class="ready-tip">方块会自动下落填充空位</text>

      <view class="level-selector">
        <view class="level-btn {{gridSize === 4 ? 'active' : ''}}" bindtap="selectLevel" data-level="4"
          style="{{gridSize === 4 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">4×4</view>
        <view class="level-btn {{gridSize === 5 ? 'active' : ''}}" bindtap="selectLevel" data-level="5"
          style="{{gridSize === 5 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">5×5</view>
        <view class="level-btn {{gridSize === 6 ? 'active' : ''}}" bindtap="selectLevel" data-level="6"
          style="{{gridSize === 6 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">6×6</view>
        <view class="level-btn {{gridSize === 7 ? 'active' : ''}}" bindtap="selectLevel" data-level="7"
          style="{{gridSize === 7 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">7×7</view>
        <view class="level-btn {{gridSize === 8 ? 'active' : ''}}" bindtap="selectLevel" data-level="8"
          style="{{gridSize === 8 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">8×8</view>
      </view>

      <button class="btn-primary start-btn" bindtap="startGame" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">开始挑战</button>
      <view class="rules-link" bindtap="openRules">📖 玩法说明</view>
    </view>
  </view>

  <!-- 游戏屏幕 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <view class="info-bar">
      <view class="info-item">
        <text class="info-label">{{timeLimit > 0 ? '剩余' : '用时'}}</text>
        <text class="info-value timer {{timeLimit > 0 && timeLeft <= 10 ? 'warning' : ''}}">{{timeLimit > 0 ? timerDisplay : currentTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">分数</text>
        <text class="info-value" style="color: {{currentSkin.accent}}">{{score}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">连击</text>
        <text class="info-value" style="color: #00B894">{{combo}}</text>
      </view>
    </view>

    <view class="grid-container">
      <view class="grid" style="grid-template-columns: repeat({{gridSize}}, 1fr);">
        <view
          class="cell {{cell.matched ? 'matched' : ''}} {{selectedCell && selectedCell.row === row && selectedCell.col === col ? 'selected' : ''}}"
          wx:for="{{grid}}"
          wx:for-item="row"
          wx:for-index="rowIdx"
          wx:key="rowIdx"
        >
          <view
            class="cell-inner"
            wx:for="{{row}}"
            wx:for-item="cell"
            wx:for-index="colIdx"
            wx:key="id"
            bindtap="tapCell"
            data-row="{{rowIdx}}"
            data-col="{{colIdx}}"
            style="background: {{cell.matched ? 'transparent' : cell.color + '30'}}; border-color: {{cell.matched ? 'transparent' : cell.color + '80'}};"
          >
            <view class="cell-dot" wx:if="{{!cell.matched}}" style="background: {{cell.color}}"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成屏幕 -->
  <view class="finish-screen" wx:if="{{gameState === 'finished'}}">
    <view class="finish-content animate-scale-in">
      <view class="rating-container">
        <view class="rating-circle" style="border-color: {{ratingColor}}; box-shadow: 0 0 40rpx {{ratingColor}}40;">
          <text class="rating-text" style="color: {{ratingColor}}">{{rating}}</text>
        </view>
        <text class="rating-label">{{pairsLeft <= 0 ? '全部消除！' : '游戏结束'}}</text>
      </view>

      <view class="result-card card">
        <view class="result-item">
          <text class="result-label">分数</text>
          <text class="result-value">{{score}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">最大连击</text>
          <text class="result-value">{{maxCombo}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">用时</text>
          <text class="result-value">{{currentTime}}</text>
        </view>
      </view>

      <view class="new-record" wx:if="{{isNewRecord}}">
        <text class="record-icon">🏆</text>
        <text class="record-text">新纪录！</text>
      </view>

      <view class="action-buttons">
        <button class="btn-double" wx:if="{{!doubleClaimed}}" bindtap="watchAdDoublePoints">📺 看视频双倍积分 (+{{earnedPoints}})</button>
        <button class="btn-double claimed" wx:else disabled>✅ 双倍积分已领取</button>
        <button class="btn-primary" bindtap="restart" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">再来一次</button>
        <button class="btn-secondary" bindtap="nextLevel" wx:if="{{gridSize < 8}}">下一难度</button>
        <button class="btn-secondary" bindtap="goHome">返回首页</button>
      </view>

      <button class="share-btn" open-type="share">
        <text class="share-icon">📤</text>
        <text class="share-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-overlay {{showGuide ? 'show' : ''}}" catchtap="closeGuide">
    <view class="guide-card" catchtap="">
      <view class="guide-icon">{{guideSteps[guideStep].icon}}</view>
      <text class="guide-title">{{guideSteps[guideStep].title}}</text>
      <text class="guide-desc">{{guideSteps[guideStep].desc}}</text>
      <view class="guide-dots">
        <view class="guide-dot {{index === guideStep ? 'active' : ''}}" wx:for="{{guideSteps}}" wx:key="index"></view>
      </view>
      <view class="guide-btns">
        <view class="guide-btn guide-skip" bindtap="closeGuide">跳过</view>
        <view class="guide-btn guide-next" bindtap="nextGuide">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始游戏'}}</view>
      </view>
    </view>
  </view>

  <!-- 玩法说明 -->
  <view class="rules-overlay {{showRules ? 'show' : ''}}" catchtap="closeRules">
    <view class="rules-card" catchtap="">
      <text class="rules-title">📖 玩法说明</text>
      <scroll-view class="rules-body" scroll-y>
        <view wx:for="{{rulesSections}}" wx:key="title">
          <text class="rules-section-title">{{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="guide-btn guide-next" bindtap="closeRules">知道了</view>
    </view>
  </view>
</view>
