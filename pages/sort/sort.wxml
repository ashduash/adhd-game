<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-title">
      <text class="title-text">序列排序</text>
      <text class="title-sub">{{level}}个数字 · 从小到大</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 准备屏幕 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-content animate-scale-in">
      <view class="ready-icon">📊</view>
      <text class="ready-title">序列排序</text>
      <text class="ready-desc">按从小到大的顺序点击数字</text>
      <text class="ready-tip">考验你的序列处理能力！</text>

      <view class="level-selector">
        <view class="level-btn {{level === 6 ? 'active' : ''}}" bindtap="selectLevel" data-level="6"
          style="{{level === 6 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">6个</view>
        <view class="level-btn {{level === 8 ? 'active' : ''}}" bindtap="selectLevel" data-level="8"
          style="{{level === 8 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">8个</view>
        <view class="level-btn {{level === 10 ? 'active' : ''}}" bindtap="selectLevel" data-level="10"
          style="{{level === 10 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">10个</view>
        <view class="level-btn {{level === 12 ? 'active' : ''}}" bindtap="selectLevel" data-level="12"
          style="{{level === 12 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">12个</view>
        <view class="level-btn {{level === 15 ? 'active' : ''}}" bindtap="selectLevel" data-level="15"
          style="{{level === 15 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">15个</view>
      </view>

      <button class="btn-primary start-btn" bindtap="startGame" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">
        开始挑战
      </button>
      <view class="rules-link" bindtap="openRules">📖 玩法说明</view>
    </view>
  </view>

  <!-- 游戏屏幕 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <!-- 信息栏 -->
    <view class="info-bar">
      <view class="info-item">
        <text class="info-label">用时</text>
        <text class="info-value timer">{{currentTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">下一个</text>
        <text class="info-value next-num" style="color: {{currentSkin.accent}}">{{nextExpected || '✓'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">进度</text>
        <text class="info-value">{{correctCount}}/{{level}}</text>
      </view>
    </view>

    <!-- 已排序区域 -->
    <view class="sorted-area" wx:if="{{correctCount > 0}}">
      <text class="sorted-label">已排序</text>
      <view class="sorted-items">
        <view class="sorted-item" wx:for="{{sortedSequence}}" wx:key="*this" wx:for-index="seqIdx"
          wx:if="{{seqIdx < correctCount}}"
          style="background: {{currentSkin.cell.successBg}}; border-color: {{currentSkin.cell.successBorder}};">
          <text style="color: {{currentSkin.cell.successText}}">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 数字网格 -->
    <view class="items-grid">
      <view
        class="item-card {{item.tapped ? 'tapped' : ''}} {{tappedIndex === item.index ? 'tapping ' + tappedType : ''}}"
        wx:for="{{items}}"
        wx:key="index"
        bindtap="tapItem"
        data-index="{{item.index}}"
        style="
          background: {{item.tapped ? currentSkin.cell.successBg + '40' : currentSkin.cell.bg}};
          border-color: {{item.tapped ? currentSkin.cell.successBorder : (tappedIndex === item.index ? (tappedType === 'success' ? currentSkin.cell.successBorder : 'rgba(255,107,107,0.4)') : currentSkin.cell.border)}};
          opacity: {{item.tapped ? 0.4 : 1}};
        "
      >
        <text class="item-number" style="color: {{item.tapped ? currentSkin.cell.successText : currentSkin.cell.text}}; text-decoration: {{item.tapped ? 'line-through' : 'none'}}">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 完成屏幕 -->
  <view class="finish-screen" wx:if="{{gameState === 'finished'}}">
    <view class="finish-content animate-scale-in">
      <view class="rating-container">
        <view class="rating-circle" style="border-color: {{ratingColor}}; box-shadow: 0 0 40rpx {{ratingColor}}40;">
          <text class="rating-text" style="color: {{ratingColor}}">{{rating}}</text>
        </view>
        <text class="rating-label">排序完成！</text>
      </view>

      <view class="result-card card">
        <view class="result-item">
          <text class="result-label">用时</text>
          <text class="result-value">{{currentTime}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">错误</text>
          <text class="result-value">{{errorCount}}次</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">项目数</text>
          <text class="result-value">{{level}}个</text>
        </view>
      </view>

      <view class="new-record" wx:if="{{isNewRecord}}">
        <text class="record-icon">🏆</text>
        <text class="record-text">新纪录！</text>
      </view>

      <view class="action-buttons">
        <button class="btn-double" wx:if="{{!doubleClaimed}}" bindtap="watchAdDoublePoints">📺 看视频双倍积分 (+{{earnedPoints}})</button>
        <button class="btn-double claimed" wx:else disabled>✅ 双倍积分已领取</button>
        <button class="btn-primary" bindtap="restart" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">再来一次</button>
        <button class="btn-secondary" bindtap="nextLevel" wx:if="{{level < 15}}">下一难度</button>
        <button class="btn-secondary" bindtap="goHome">返回首页</button>
      </view>

      <button class="share-btn" open-type="share">
        <text class="share-icon">📤</text>
        <text class="share-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-overlay {{showGuide ? 'show' : ''}}" catchtap="closeGuide">
    <view class="guide-card" catchtap="">
      <view class="guide-icon">{{guideSteps[guideStep].icon}}</view>
      <text class="guide-title">{{guideSteps[guideStep].title}}</text>
      <text class="guide-desc">{{guideSteps[guideStep].desc}}</text>
      <view class="guide-dots">
        <view class="guide-dot {{index === guideStep ? 'active' : ''}}" wx:for="{{guideSteps}}" wx:key="index"></view>
      </view>
      <view class="guide-btns">
        <view class="guide-btn guide-skip" bindtap="closeGuide">跳过</view>
        <view class="guide-btn guide-next" bindtap="nextGuide">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始游戏'}}</view>
      </view>
    </view>
  </view>

  <!-- 玩法说明 -->
  <view class="rules-overlay {{showRules ? 'show' : ''}}" catchtap="closeRules">
    <view class="rules-card" catchtap="">
      <text class="rules-title">📖 玩法说明</text>
      <scroll-view class="rules-body" scroll-y>
        <view wx:for="{{rulesSections}}" wx:key="title">
          <text class="rules-section-title">{{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="guide-btn guide-next" bindtap="closeRules">知道了</view>
    </view>
  </view>
</view>
