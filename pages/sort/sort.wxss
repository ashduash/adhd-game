/* 页面基础 */
.page { min-height: 100vh; opacity: 0; transition: opacity 0.4s ease; }
.page.show { opacity: 1; }

/* 导航栏 */
.nav-bar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; padding-top: 80rpx; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border-radius: 50%; transition: transform 0.2s ease; }
.nav-back:active { transform: scale(0.9); }
.back-icon { font-size: 32rpx; color: #ffffff; }
.nav-title { display: flex; flex-direction: column; align-items: center; }
.title-text { font-size: 32rpx; font-weight: 700; color: #ffffff; }
.title-sub { font-size: 24rpx; color: rgba(255,255,255,0.5); }

/* 准备屏幕 */
.ready-screen { display: flex; align-items: center; justify-content: center; min-height: 80vh; padding: 32rpx; }
.ready-content { display: flex; flex-direction: column; align-items: center; width: 100%; }
.animate-scale-in { animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
.ready-icon { font-size: 96rpx; margin-bottom: 24rpx; animation: float 3s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
.ready-title { font-size: 40rpx; font-weight: 700; color: #ffffff; margin-bottom: 12rpx; }
.ready-desc { font-size: 28rpx; color: rgba(255,255,255,0.7); margin-bottom: 8rpx; }
.ready-tip { font-size: 24rpx; color: rgba(255,255,255,0.5); margin-bottom: 48rpx; }

/* 难度选择 */
.level-selector { display: flex; gap: 16rpx; margin-bottom: 48rpx; flex-wrap: wrap; justify-content: center; }
.level-btn { padding: 16rpx 24rpx; background: rgba(255,255,255,0.08); border-radius: 16rpx; font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,0.6); border: 2rpx solid rgba(255,255,255,0.1); transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); }
.level-btn:active { transform: scale(0.92); }
.level-btn.active { color: #ffffff; box-shadow: 0 4rpx 20rpx rgba(192,122,69,0.3); }
.start-btn { width: 100%; max-width: 400rpx; border-radius: 24rpx; font-weight: 700; box-shadow: 0 8rpx 32rpx rgba(192,122,69,0.3); transition: transform 0.2s ease; }
.start-btn:active { transform: scale(0.96); }

/* 游戏屏幕 */
.game-screen { padding: 0 24rpx; }

/* 信息栏 */
.info-bar { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border-radius: 24rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(255,255,255,0.08); }
.info-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.info-label { font-size: 22rpx; color: rgba(255,255,255,0.5); }
.info-value { font-size: 28rpx; font-weight: 600; color: #ffffff; }
.timer { font-family: 'Courier New', monospace; font-size: 32rpx; color: #00D2FF; }
.next-num { font-size: 40rpx; font-weight: 800; }

/* 已排序区域 */
.sorted-area { margin-bottom: 24rpx; padding: 16rpx 20rpx; background: rgba(255,255,255,0.04); border-radius: 16rpx; }
.sorted-label { font-size: 22rpx; color: rgba(255,255,255,0.4); margin-bottom: 12rpx; display: block; }
.sorted-items { display: flex; flex-wrap: wrap; gap: 10rpx; }
.sorted-item { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; border: 2rpx solid; font-size: 24rpx; font-weight: 700; animation: sortedPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes sortedPop { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }

/* 数字网格 */
.items-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; padding: 8rpx; }
.item-card { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; border: 2rpx solid; cursor: pointer; transition: transform 0.12s cubic-bezier(0.25, 0.46, 0.45, 0.94), background 0.15s ease, border-color 0.15s ease, opacity 0.2s ease; }
.item-card:active { transform: scale(0.92); }
.item-card.tapped { pointer-events: none; }
.item-card.tapping { transform: scale(0.92); transition: transform 0.08s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
.item-card.tapping.success { box-shadow: 0 0 0 4rpx rgba(0,184,148,0.3); }
.item-card.tapping.error { box-shadow: 0 0 0 4rpx rgba(255,107,107,0.3); animation: cellErrorShake 0.2s ease; }
@keyframes cellErrorShake { 0%, 100% { transform: scale(0.92) translateX(0); } 25% { transform: scale(0.92) translateX(-4rpx); } 75% { transform: scale(0.92) translateX(4rpx); } }
.item-number { font-size: 36rpx; font-weight: 800; transition: all 0.15s ease; }

/* 完成屏幕 */
.finish-screen { display: flex; align-items: center; justify-content: center; min-height: 80vh; padding: 32rpx; }
.finish-content { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 500rpx; }
.rating-container { display: flex; flex-direction: column; align-items: center; margin-bottom: 40rpx; }
.rating-circle { width: 160rpx; height: 160rpx; border-radius: 50%; border: 6rpx solid; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; animation: ratingAppear 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes ratingAppear { from { opacity: 0; transform: scale(0.5) rotate(-10deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
.rating-text { font-size: 72rpx; font-weight: 800; }
.rating-label { font-size: 32rpx; font-weight: 600; color: #ffffff; }
.result-card { width: 100%; display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-bottom: 24rpx; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border-radius: 24rpx; padding: 32rpx; border: 1rpx solid rgba(255,255,255,0.08); }
.result-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; flex: 1; }
.result-label { font-size: 24rpx; color: rgba(255,255,255,0.5); }
.result-value { font-size: 32rpx; font-weight: 700; color: #ffffff; }
.result-divider { width: 2rpx; height: 60rpx; background: rgba(255,255,255,0.1); }
.new-record { display: flex; align-items: center; gap: 12rpx; margin-bottom: 32rpx; padding: 16rpx 32rpx; background: linear-gradient(135deg, rgba(255,215,0,0.2) 0%, rgba(255,165,0,0.2) 100%); border-radius: 32rpx; border: 1rpx solid rgba(255,215,0,0.3); animation: newRecordPulse 1.5s ease-in-out infinite; }
@keyframes newRecordPulse { 0%, 100% { box-shadow: 0 0 20rpx rgba(255,215,0,0.2); } 50% { box-shadow: 0 0 40rpx rgba(255,215,0,0.4); } }
.record-icon { font-size: 32rpx; }
.record-text { font-size: 28rpx; font-weight: 600; color: #FFD700; }
.action-buttons { display: flex; flex-direction: column; gap: 16rpx; width: 100%; margin-bottom: 24rpx; }
.action-buttons .btn-primary, .action-buttons .btn-secondary { width: 100%; border-radius: 20rpx; font-weight: 600; transition: transform 0.2s ease; }
.action-buttons .btn-primary:active, .action-buttons .btn-secondary:active { transform: scale(0.96); }
.btn-double { width: 100%; height: 88rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); color: #1a1a2e; border: none; display: flex; align-items: center; justify-content: center; }
.btn-double.claimed { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.5); }
.share-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx; background: none; border: none; padding: 20rpx; transition: opacity 0.2s ease; }
.share-btn:active { opacity: 0.7; }
.share-icon { font-size: 28rpx; }
.share-text { font-size: 26rpx; color: rgba(255,255,255,0.6); }
