<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome"><text class="back-icon">←</text></view>
    <view class="nav-title">
      <text class="title-text">训练计划</text>
      <text class="title-sub">5天周期 · 每日3关</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 进度概览 -->
  <view class="progress-overview">
    <view class="day-dots">
      <view class="day-dot {{index === dayIndex ? 'current' : ''}} {{index < completedDays ? 'done' : ''}}"
        wx:for="{{totalDays}}" wx:key="*this">
        <text class="dot-text">{{index + 1}}</text>
      </view>
    </view>
    <text class="progress-label">第 {{dayIndex + 1}} / {{totalDays}} 天</text>
  </view>

  <!-- 今日主题 -->
  <view class="theme-card card" wx:if="{{currentDay}}">
    <text class="theme-icon">{{currentDay.icon}}</text>
    <view class="theme-info">
      <text class="theme-title">今日主题：{{currentDay.theme}}</text>
      <text class="theme-desc">{{currentDay.desc}}</text>
    </view>
    <view class="theme-status {{isCompleted ? 'done' : ''}}">
      <text>{{isCompleted ? '已完成' : '未完成'}}</text>
    </view>
  </view>

  <!-- 今日游戏列表 -->
  <view class="section-title">
    <text>今日训练</text>
  </view>

  <view class="game-list" wx:if="{{currentDay}}">
    <view class="game-card card" wx:for="{{currentDay.games}}" wx:key="mode"
      bindtap="startGame" data-mode="{{item.mode}}" data-level="{{item.level}}">
      <view class="game-info">
        <text class="game-name">{{item.name}}</text>
        <text class="game-skill">{{item.skill}}</text>
      </view>
      <view class="game-arrow">
        <text>→</text>
      </view>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip-card" wx:if="{{!isCompleted}}">
    <text class="tip-text">完成全部3个训练即可打卡成功</text>
  </view>
</view>
