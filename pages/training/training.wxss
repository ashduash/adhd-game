.page { min-height: 100vh; opacity: 0; transition: opacity 0.4s ease; padding-bottom: 40rpx; }
.page.show { opacity: 1; }
.nav-bar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; padding-top: 80rpx; }
.nav-back, .nav-placeholder { width: 64rpx; height: 64rpx; }
.nav-back { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border-radius: 50%; transition: transform 0.2s ease; }
.nav-back:active { transform: scale(0.9); }
.back-icon { font-size: 32rpx; color: #ffffff; }
.nav-title { display: flex; flex-direction: column; align-items: center; }
.title-text { font-size: 32rpx; font-weight: 700; color: #ffffff; }
.title-sub { font-size: 24rpx; color: rgba(255,255,255,0.5); }

.progress-overview { display: flex; flex-direction: column; align-items: center; padding: 32rpx; }
.day-dots { display: flex; gap: 24rpx; margin-bottom: 16rpx; }
.day-dot { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border: 2rpx solid rgba(255,255,255,0.15); transition: all 0.3s ease; }
.day-dot.current { background: rgba(192,122,69,0.3); border-color: #C07A45; box-shadow: 0 0 20rpx rgba(192,122,69,0.3); }
.day-dot.done { background: rgba(0,184,148,0.3); border-color: #00B894; }
.dot-text { font-size: 24rpx; font-weight: 700; color: #ffffff; }
.progress-label { font-size: 26rpx; color: rgba(255,255,255,0.5); }

.theme-card { margin: 0 24rpx 24rpx; display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }
.theme-icon { font-size: 56rpx; }
.theme-info { flex: 1; }
.theme-title { font-size: 30rpx; font-weight: 700; color: #ffffff; display: block; margin-bottom: 6rpx; }
.theme-desc { font-size: 24rpx; color: rgba(255,255,255,0.5); }
.theme-status { padding: 8rpx 20rpx; border-radius: 20rpx; background: rgba(255,255,255,0.08); font-size: 22rpx; color: rgba(255,255,255,0.5); }
.theme-status.done { background: rgba(0,184,148,0.2); color: #00B894; }

.section-title { padding: 0 32rpx; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; color: rgba(255,255,255,0.6); }

.game-list { padding: 0 24rpx; }
.game-card { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; margin-bottom: 16rpx; transition: transform 0.2s ease; }
.game-card:active { transform: scale(0.98); }
.game-info { flex: 1; }
.game-name { font-size: 30rpx; font-weight: 600; color: #ffffff; display: block; margin-bottom: 4rpx; }
.game-skill { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.game-arrow { font-size: 28rpx; color: rgba(255,255,255,0.3); }

.tip-card { margin: 32rpx 24rpx; padding: 24rpx; background: rgba(192,122,69,0.1); border-radius: 16rpx; border: 1rpx solid rgba(192,122,69,0.2); text-align: center; }
.tip-text { font-size: 26rpx; color: rgba(255,255,255,0.6); }
