<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-title">
      <text class="title-text">斯特鲁普</text>
      <text class="title-sub">{{level}}题 · 认知抑制挑战</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 准备屏幕 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-content animate-scale-in">
      <view class="ready-icon">🎭</view>
      <text class="ready-title">斯特鲁普测试</text>
      <text class="ready-desc">说出文字的颜色，而不是文字本身</text>
      <text class="ready-tip">例如："红"字用蓝色显示 → 点蓝色</text>

      <view class="level-selector">
        <view class="level-btn {{level === 15 ? 'active' : ''}}" bindtap="selectLevel" data-level="15"
          style="{{level === 15 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">15题</view>
        <view class="level-btn {{level === 25 ? 'active' : ''}}" bindtap="selectLevel" data-level="25"
          style="{{level === 25 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">25题</view>
        <view class="level-btn {{level === 35 ? 'active' : ''}}" bindtap="selectLevel" data-level="35"
          style="{{level === 35 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">35题</view>
        <view class="level-btn {{level === 45 ? 'active' : ''}}" bindtap="selectLevel" data-level="45"
          style="{{level === 45 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">45题</view>
        <view class="level-btn {{level === 60 ? 'active' : ''}}" bindtap="selectLevel" data-level="60"
          style="{{level === 60 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}">60题</view>
      </view>

      <button class="btn-primary start-btn" bindtap="startGame" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">
        开始挑战
      </button>
      <view class="rules-link" bindtap="openRules">📖 玩法说明</view>
    </view>
  </view>

  <!-- 游戏屏幕 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <!-- 信息栏 -->
    <view class="info-bar">
      <view class="info-item">
        <text class="info-label">用时</text>
        <text class="info-value timer">{{currentTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">进度</text>
        <text class="info-value">{{questionIndex}}/{{totalQuestions}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">正确</text>
        <text class="info-value" style="color: #00B894">{{correctCount}}</text>
      </view>
    </view>

    <!-- 颜色词显示 -->
    <view class="word-display" wx:if="{{currentQuestion}}">
      <text class="color-word" style="color: {{currentQuestion.displayColor}}">{{currentQuestion.word}}</text>
      <text class="word-hint">这个字的颜色是？</text>
    </view>

    <!-- 颜色按钮 -->
    <view class="color-buttons" wx:if="{{currentQuestion}}">
      <view
        class="color-btn {{tappedIndex === index ? 'tapping ' + tappedType : ''}}"
        wx:for="{{currentQuestion.options}}"
        wx:key="name"
        bindtap="tapOption"
        data-index="{{index}}"
        style="background: {{item.hex}}20; border-color: {{item.hex}}60;"
      >
        <view class="color-dot" style="background: {{item.hex}}"></view>
        <text class="color-name" style="color: {{item.hex}}">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 完成屏幕 -->
  <view class="finish-screen" wx:if="{{gameState === 'finished'}}">
    <view class="finish-content animate-scale-in">
      <view class="rating-container">
        <view class="rating-circle" style="border-color: {{ratingColor}}; box-shadow: 0 0 40rpx {{ratingColor}}40;">
          <text class="rating-text" style="color: {{ratingColor}}">{{rating}}</text>
        </view>
        <text class="rating-label">斯特鲁普测试完成！</text>
      </view>

      <view class="result-card card">
        <view class="result-item">
          <text class="result-label">正确率</text>
          <text class="result-value">{{accuracy}}%</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">答对</text>
          <text class="result-value">{{correctCount}}/{{totalQuestions}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">用时</text>
          <text class="result-value">{{currentTime}}</text>
        </view>
      </view>

      <view class="new-record" wx:if="{{isNewRecord}}">
        <text class="record-icon">🏆</text>
        <text class="record-text">新纪录！</text>
      </view>

      <view class="action-buttons">
        <button class="btn-double" wx:if="{{!doubleClaimed}}" bindtap="watchAdDoublePoints">📺 看视频双倍积分 (+{{earnedPoints}})</button>
        <button class="btn-double claimed" wx:else disabled>✅ 双倍积分已领取</button>
        <button class="btn-primary" bindtap="restart" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">再来一次</button>
        <button class="btn-secondary" bindtap="nextLevel" wx:if="{{level < 60}}">下一难度</button>
        <button class="btn-secondary" bindtap="goHome">返回首页</button>
      </view>

      <button class="share-btn" open-type="share">
        <text class="share-icon">📤</text>
        <text class="share-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-overlay {{showGuide ? 'show' : ''}}" catchtap="closeGuide">
    <view class="guide-card" catchtap="">
      <view class="guide-icon">{{guideSteps[guideStep].icon}}</view>
      <text class="guide-title">{{guideSteps[guideStep].title}}</text>
      <text class="guide-desc">{{guideSteps[guideStep].desc}}</text>
      <view class="guide-dots">
        <view class="guide-dot {{index === guideStep ? 'active' : ''}}" wx:for="{{guideSteps}}" wx:key="index"></view>
      </view>
      <view class="guide-btns">
        <view class="guide-btn guide-skip" bindtap="closeGuide">跳过</view>
        <view class="guide-btn guide-next" bindtap="nextGuide">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始游戏'}}</view>
      </view>
    </view>
  </view>

  <!-- 玩法说明 -->
  <view class="rules-overlay {{showRules ? 'show' : ''}}" catchtap="closeRules">
    <view class="rules-card" catchtap="">
      <text class="rules-title">📖 玩法说明</text>
      <scroll-view class="rules-body" scroll-y>
        <view wx:for="{{rulesSections}}" wx:key="title">
          <text class="rules-section-title">{{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="guide-btn guide-next" bindtap="closeRules">知道了</view>
    </view>
  </view>
</view>
