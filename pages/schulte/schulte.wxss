/* 页面基础 */
.page {
  min-height: 100vh;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.page.show {
  opacity: 1;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: 80rpx;
}

.nav-back,
.nav-skin {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.nav-back:active,
.nav-skin:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.skin-icon {
  font-size: 28rpx;
}

.nav-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 皮肤选择器 */
.skin-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(20px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.skin-picker.show {
  opacity: 1;
  pointer-events: auto;
}

.skin-picker-content {
  width: 80%;
  max-width: 500rpx;
  background: rgba(30, 30, 50, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.skin-picker.show .skin-picker-content {
  transform: scale(1);
}

.skin-picker-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 32rpx;
}

.skin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skin-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.skin-item:active {
  transform: scale(0.98);
}

.skin-item.active {
  border-color: rgba(108, 92, 231, 0.5);
  background: rgba(108, 92, 231, 0.15);
}

.skin-item.locked {
  opacity: 0.6;
  border-style: dashed;
}

.skin-item.locked .skin-item-desc {
  color: #00D2FF;
}

.skin-item-icon {
  font-size: 40rpx;
}

.skin-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.skin-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.skin-item-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 准备屏幕 */
.ready-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 32rpx;
}

.ready-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.animate-scale-in {
  animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.ready-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.ready-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.ready-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.ready-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 48rpx;
}

/* 提示开关 */
.hint-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.hint-toggle:active {
  transform: scale(0.95);
}

.hint-toggle.active {
  border-color: rgba(108, 92, 231, 0.5);
  background: rgba(108, 92, 231, 0.15);
}

.hint-toggle-icon {
  font-size: 36rpx;
}

.hint-toggle-label {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
}

.hint-toggle.active .hint-toggle-label {
  color: #ffffff;
}

/* 难度选择 */
.level-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 48rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.level-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.level-btn:active {
  transform: scale(0.92);
}

.level-btn.active {
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.3);
}

.start-btn {
  width: 100%;
  max-width: 400rpx;
  border-radius: 24rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.start-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.2);
}

/* 游戏屏幕 */
.game-screen {
  padding: 0 24rpx;
}

/* 信息栏 */
.info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.info-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.timer {
  font-family: 'Courier New', monospace;
  font-size: 32rpx;
  color: #00D2FF;
}

.next-num {
  font-size: 40rpx;
  font-weight: 800;
}

/* 网格 */
.grid-container {
  display: flex;
  justify-content: center;
  padding: 8rpx;
}

.grid {
  display: grid;
  width: 100%;
  max-width: 650rpx;
}

/* 格子 - 基础样式 */
.grid-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx solid;
  cursor: pointer;
  position: relative;
  overflow: hidden;

  /* 关键：使用cubic-bezier实现类似键盘的弹性按压效果 */
  transition:
    transform 0.12s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

/* 按压效果 - 模拟键盘手感 */
.grid-cell.tapping {
  transform: scale(0.92);
  transition: transform 0.08s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.grid-cell.tapping.success {
  box-shadow: 0 0 0 4rpx rgba(0, 184, 148, 0.3);
}

.grid-cell.tapping.error {
  box-shadow: 0 0 0 4rpx rgba(255, 107, 107, 0.3);
  animation: errorShake 0.2s ease;
}

/* 释放效果 */
.grid-cell.tapped {
  transform: scale(1);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 错误抖动 - 更柔和 */
@keyframes errorShake {
  0%, 100% { transform: scale(0.92) translateX(0); }
  25% { transform: scale(0.92) translateX(-4rpx); }
  75% { transform: scale(0.92) translateX(4rpx); }
}

.cell-number {
  font-weight: 700;
  transition: all 0.15s ease;
  position: relative;
  z-index: 1;
}

.grid-cell.tapped .cell-number {
  animation: checkPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes checkPop {
  0% { transform: scale(0.5); opacity: 0; }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}

/* 完成屏幕 */
.finish-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 32rpx;
}

.finish-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 500rpx;
}

/* 评级 */
.rating-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.rating-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  animation: ratingAppear 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes ratingAppear {
  from {
    opacity: 0;
    transform: scale(0.5) rotate(-10deg);
  }
  to {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

.rating-text {
  font-size: 72rpx;
  font-weight: 800;
}

.rating-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 成绩卡片 */
.result-card {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.result-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.result-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: 'Courier New', monospace;
}

.result-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 新纪录 */
.new-record {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 165, 0, 0.2) 100%);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  animation: newRecordPulse 1.5s ease-in-out infinite;
}

@keyframes newRecordPulse {
  0%, 100% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.2); }
  50% { box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.4); }
}

.record-icon {
  font-size: 32rpx;
}

.record-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFD700;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  width: 100%;
  border-radius: 20rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.action-buttons .btn-primary:active,
.action-buttons .btn-secondary:active {
  transform: scale(0.96);
}

/* 双倍积分按钮 */
.btn-double {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #1a1a2e;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-double.claimed {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 20rpx;
  transition: opacity 0.2s ease;
}

.share-btn:active {
  opacity: 0.7;
}

.share-icon {
  font-size: 28rpx;
}

.share-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}
