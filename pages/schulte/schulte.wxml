<view class="page {{show ? 'show' : ''}}" style="background: {{currentSkin.background}}">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goHome">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-title">
      <text class="title-text">数字风暴</text>
      <text class="title-sub">{{level}}×{{level}}</text>
    </view>
    <view class="nav-skin" bindtap="toggleSkinPicker">
      <text class="skin-icon">{{currentSkin.icon}}</text>
    </view>
  </view>

  <!-- 皮肤选择器 -->
  <view class="skin-picker {{showSkinPicker ? 'show' : ''}}" catchtap="toggleSkinPicker">
    <view class="skin-picker-content" catchtap="">
      <view class="skin-picker-title">选择皮肤</view>
      <view class="skin-list">
        <view
          class="skin-item {{currentSkin.id === item.id ? 'active' : ''}} {{item.locked ? 'locked' : ''}}"
          wx:for="{{skinList}}"
          wx:key="id"
          bindtap="selectSkin"
          data-id="{{item.id}}"
        >
          <text class="skin-item-icon">{{item.locked ? '🔒' : item.icon}}</text>
          <text class="skin-item-name">{{item.name}}</text>
          <text class="skin-item-desc">{{item.locked ? '看视频解锁' : item.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 准备状态 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-content animate-scale-in">
      <view class="ready-icon">⚡</view>
      <text class="ready-title">{{level}}×{{level}} 数字风暴</text>
      <text class="ready-desc">按顺序点击 1 到 {{totalNumbers}}</text>
      <text class="ready-tip">越快越好！</text>

      <!-- 提示开关 -->
      <view
        class="hint-toggle {{hintMode ? 'active' : ''}}"
        bindtap="toggleHint"
        style="{{hintMode ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
      >
        <text class="hint-toggle-icon">💡</text>
        <text class="hint-toggle-label">{{hintMode ? '提示已开启' : '提示已关闭'}}</text>
      </view>

      <!-- 难度选择 -->
      <view class="level-selector">
        <view
          class="level-btn {{level === 3 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="3"
          style="{{level === 3 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >3×3</view>
        <view
          class="level-btn {{level === 4 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="4"
          style="{{level === 4 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >4×4</view>
        <view
          class="level-btn {{level === 5 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="5"
          style="{{level === 5 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >5×5</view>
        <view
          class="level-btn {{level === 6 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="6"
          style="{{level === 6 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >6×6</view>
        <view
          class="level-btn {{level === 7 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="7"
          style="{{level === 7 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >7×7</view>
        <view
          class="level-btn {{level === 8 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="8"
          style="{{level === 8 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >8×8</view>
        <view
          class="level-btn {{level === 9 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="9"
          style="{{level === 9 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >9×9</view>
        <view
          class="level-btn {{level === 10 ? 'active' : ''}}"
          bindtap="selectLevel"
          data-level="10"
          style="{{level === 10 ? 'border-color:' + currentSkin.accent + ';background:' + currentSkin.accent + '30' : ''}}"
        >10×10</view>
      </view>

      <button class="btn-primary start-btn" bindtap="startGame" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">
        开始挑战
      </button>
      <view class="rules-link" bindtap="openRules">📖 玩法说明</view>
    </view>
  </view>

  <!-- 游戏状态 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <!-- 信息栏 -->
    <view class="info-bar">
      <view class="info-item">
        <text class="info-label">用时</text>
        <text class="info-value timer">{{currentTime}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">下一个</text>
        <text class="info-value next-num" style="color: {{currentSkin.accent}}">{{nextNumber}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">进度</text>
        <text class="info-value">{{nextNumber - 1}}/{{totalNumbers}}</text>
      </view>
    </view>

    <!-- 网格 -->
    <view class="grid-container">
      <view class="grid" style="grid-template-columns: repeat({{level}}, 1fr); gap: {{level >= 6 ? '8rpx' : '12rpx'}};">
        <view
          class="grid-cell {{item.tapped ? 'tapped' : ''}} {{tappedIndex === item.index ? 'tapping ' + tappedType : ''}}"
          wx:for="{{grid}}"
          wx:key="index"
          bindtap="tapCell"
          data-index="{{item.index}}"
          style="
            background: {{item.tapped ? currentSkin.cell.successBg : item.isNext && hintMode ? currentSkin.cell.activeBg : currentSkin.cell.bg}};
            border-color: {{item.tapped ? currentSkin.cell.successBorder : item.isNext && hintMode ? currentSkin.cell.activeBorder : currentSkin.cell.border}};
          "
        >
          <text class="cell-number" style="
            color: {{item.tapped ? currentSkin.cell.successText : currentSkin.cell.text}};
            font-size: {{level >= 6 ? '28rpx' : '36rpx'}};
          ">{{item.tapped ? '✓' : item.number}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成状态 -->
  <view class="finish-screen" wx:if="{{gameState === 'finished'}}">
    <view class="finish-content animate-scale-in">
      <!-- 评级 -->
      <view class="rating-container">
        <view class="rating-circle" style="border-color: {{ratingColor}}; box-shadow: 0 0 40rpx {{ratingColor}}40;">
          <text class="rating-text" style="color: {{ratingColor}}">{{rating}}</text>
        </view>
        <text class="rating-label" wx:if="{{rating === 'S'}}">完美！</text>
        <text class="rating-label" wx:elif="{{rating === 'A'}}">优秀！</text>
        <text class="rating-label" wx:elif="{{rating === 'B'}}">不错！</text>
        <text class="rating-label" wx:elif="{{rating === 'C'}}">继续加油</text>
        <text class="rating-label" wx:else="">{{rating}}</text>
      </view>

      <!-- 成绩 -->
      <view class="result-card card">
        <view class="result-item">
          <text class="result-label">用时</text>
          <text class="result-value">{{currentTime}}</text>
        </view>
        <view class="result-divider"></view>
        <view class="result-item">
          <text class="result-label">难度</text>
          <text class="result-value">{{level}}×{{level}}</text>
        </view>
      </view>

      <!-- 新纪录 -->
      <view class="new-record" wx:if="{{isNewRecord}}">
        <text class="record-icon">🏆</text>
        <text class="record-text">新纪录！</text>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button class="btn-double" wx:if="{{!doubleClaimed}}" bindtap="watchAdDoublePoints">
          📺 看视频双倍积分 (+{{earnedPoints}})
        </button>
        <button class="btn-double claimed" wx:else disabled>
          ✅ 双倍积分已领取
        </button>
        <button class="btn-primary" bindtap="restart" style="background: linear-gradient(135deg, {{currentSkin.accent}} 0%, {{currentSkin.accent}}88 100%)">再来一次</button>
        <button class="btn-secondary" bindtap="nextLevel" wx:if="{{level < 10}}">下一难度</button>
        <button class="btn-secondary" bindtap="goHome">返回首页</button>
      </view>

      <!-- 分享按钮 -->
      <button class="share-btn" open-type="share">
        <text class="share-icon">📤</text>
        <text class="share-text">分享成绩</text>
      </button>
    </view>
  </view>

  <!-- 新手引导 -->
  <view class="guide-overlay {{showGuide ? 'show' : ''}}" catchtap="closeGuide">
    <view class="guide-card" catchtap="">
      <view class="guide-icon">{{guideSteps[guideStep].icon}}</view>
      <text class="guide-title">{{guideSteps[guideStep].title}}</text>
      <text class="guide-desc">{{guideSteps[guideStep].desc}}</text>
      <view class="guide-dots">
        <view class="guide-dot {{index === guideStep ? 'active' : ''}}" wx:for="{{guideSteps}}" wx:key="index"></view>
      </view>
      <view class="guide-btns">
        <view class="guide-btn guide-skip" bindtap="closeGuide">跳过</view>
        <view class="guide-btn guide-next" bindtap="nextGuide">{{guideStep < guideSteps.length - 1 ? '下一步' : '开始游戏'}}</view>
      </view>
    </view>
  </view>

  <!-- 玩法说明 -->
  <view class="rules-overlay {{showRules ? 'show' : ''}}" catchtap="closeRules">
    <view class="rules-card" catchtap="">
      <text class="rules-title">📖 玩法说明</text>
      <scroll-view class="rules-body" scroll-y>
        <view wx:for="{{rulesSections}}" wx:key="title">
          <text class="rules-section-title">{{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="guide-btn guide-next" bindtap="closeRules">知道了</view>
    </view>
  </view>
</view>
