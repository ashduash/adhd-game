<view class="page {{show ? 'show' : ''}}">
  <!-- 应用信息 -->
  <view class="app-info">
    <view class="app-icon-wrapper">
      <text class="app-icon">🧠</text>
    </view>
    <text class="app-name">专注风暴</text>
    <text class="app-version">v1.0.0</text>
    <text class="app-desc">专注力训练 · 思维挑战游戏</text>
  </view>

  <!-- 详情列表 -->
  <view class="info-section">
    <view class="info-item">
      <text class="info-label">版本号</text>
      <text class="info-value">1.0.0</text>
    </view>
    <view class="info-item">
      <text class="info-label">更新日期</text>
      <text class="info-value">2026年5月29日</text>
    </view>
    <view class="info-item">
