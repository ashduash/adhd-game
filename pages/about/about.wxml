          <text class="feature-name">数字风暴</text>
          <text class="feature-desc">舒尔特方格训练，提升注意力集中能力</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🧠</text>
        <view class="feature-detail">
          <text class="feature-name">记忆还原</text>
          <text class="feature-desc">数字记忆训练，锻炼短期记忆能力</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">👁️</text>
        <view class="feature-detail">
          <text class="feature-name">闪电扫视</text>
          <text class="feature-desc">视觉搜索训练，提升信息捕捉速度</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🎭</text>
        <view class="feature-detail">
          <text class="feature-name">斯特鲁普</text>
          <text class="feature-desc">抗干扰训练，增强认知控制能力</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🎯</text>
        <view class="feature-detail">
          <text class="feature-name">极速反应</text>
          <text class="feature-desc">反应速度训练，提高响应敏捷度</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🌈</text>
        <view class="feature-detail">
          <text class="feature-name">色彩消除</text>
          <text class="feature-desc">颜色匹配训练，锻炼视觉辨别能力</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">📊</text>
        <view class="feature-detail">
          <text class="feature-name">序列排序</text>
          <text class="feature-desc">逻辑排序训练，提升工作记忆能力</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🔀</text>
        <view class="feature-detail">
          <text class="feature-name">双线任务</text>
          <text class="feature-desc">多任务处理训练，增强注意力分配能力</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 版权信息 -->
  <view class="copyright">
    <text class="copyright-text">Copyright © 2026 专注风暴团队</text>
