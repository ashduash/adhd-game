.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.page.show {
  opacity: 1;
}

/* 应用信息 */
.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
  gap: 12rpx;
}

.app-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(108, 92, 231, 0.3);
}

.app-icon {
  font-size: 64rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.app-version {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.app-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
}

/* 详情列表 */
.info-section {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 32rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.info-value {
  font-size: 28rpx;
  color: #ffffff;
}

/* 功能介绍 */
.feature-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.feature-icon {
  font-size: 36rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(108, 92, 231, 0.15);
  border-radius: 14rpx;
}

.feature-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.feature-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 版权信息 */
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 32rpx 0;
}

.copyright-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
}
