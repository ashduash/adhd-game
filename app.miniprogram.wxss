/* 全局样式 */
page {
  background: linear-gradient(180deg, #1C1715 0%, #2A2320 100%);
  min-height: 100vh;
  color: #F5EDE6;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 通用类 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(245, 237, 230, 0.07);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(245, 237, 230, 0.1);
}

.card-glass {
  background: rgba(245, 237, 230, 0.04);
  backdrop-filter: blur(40px);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(245, 237, 230, 0.06);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(192, 122, 69, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(192, 122, 69, 0.25);
}

.btn-secondary {
  background: rgba(245, 237, 230, 0.08);
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  color: #F5EDE6;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: 1rpx solid rgba(245, 237, 230, 0.15);
  transition: transform 0.2s ease;
}

.btn-secondary:active {
  transform: scale(0.95);
  background: rgba(245, 237, 230, 0.12);
}

/* 文字样式 */
.text-primary {
  color: #F5EDE6;
}

.text-secondary {
  color: rgba(245, 237, 230, 0.5);
}

.text-accent {
  color: #D4A574;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #C07A45 0%, #D4A574 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5rpx); }
  75% { transform: translateX(5rpx); }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out forwards;
}

.animate-scale-in {
  animation: scaleIn 0.3s ease-out forwards;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* 段位颜色 */
.rank-bronze { color: #CD7F32; }
.rank-silver { color: #B0A898; }
.rank-gold { color: #D4A04A; }
.rank-platinum { color: #7BA5A0; }
.rank-diamond { color: #9CC5C0; }
.rank-master { color: #C07A70; }
.rank-king { color: #D4A04A; text-shadow: 0 0 10px rgba(212, 160, 74, 0.4); }

/* ========== 新手引导弹窗 ========== */
.guide-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 12, 10, 0.78);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.guide-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.guide-card {
  width: 85%;
  max-width: 550rpx;
  background: rgba(38, 32, 28, 0.98);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.guide-overlay.show .guide-card {
  transform: scale(1);
}

.guide-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5EDE6;
  margin-bottom: 16rpx;
  display: block;
}

.guide-desc {
  font-size: 28rpx;
  color: rgba(245, 237, 230, 0.65);
  line-height: 1.6;
  margin-bottom: 40rpx;
  display: block;
}

.guide-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(245, 237, 230, 0.15);
  transition: all 0.3s ease;
}

.guide-dot.active {
  width: 24rpx;
  background: #C07A45;
}

.guide-btns {
  display: flex;
  gap: 16rpx;
}

.guide-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.15s ease;
}

.guide-btn:active {
  transform: scale(0.95);
}

.guide-skip {
  background: rgba(245, 237, 230, 0.08);
  color: rgba(245, 237, 230, 0.5);
}

.guide-next {
  background: linear-gradient(135deg, #D4A574 0%, #C07A45 100%);
  color: #fff;
}

/* ========== 玩法说明弹窗 ========== */
.rules-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 12, 10, 0.78);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 150;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.rules-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.rules-card {
  width: 85%;
  max-width: 550rpx;
  max-height: 80vh;
  background: rgba(38, 32, 28, 0.98);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.rules-overlay.show .rules-card {
  transform: scale(1);
}

.rules-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5EDE6;
  margin-bottom: 24rpx;
  text-align: center;
  display: block;
}

.rules-body {
  flex: 1;
  max-height: 55vh;
  overflow-y: auto;
  margin-bottom: 32rpx;
}

.rules-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4A574;
  margin-bottom: 8rpx;
  display: block;
}

.rules-section-text {
  font-size: 26rpx;
  color: rgba(245, 237, 230, 0.65);
  line-height: 1.8;
  margin-bottom: 24rpx;
  display: block;
}

/* ========== 玩法说明链接 ========== */
.rules-link {
  font-size: 26rpx;
  color: rgba(245, 237, 230, 0.45);
  padding: 16rpx;
  margin-top: 16rpx;
  text-align: center;
}
